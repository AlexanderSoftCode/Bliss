---
interface Props {
	/** Tailwind sizing classes, so callers can match the icon to their text size. */
	size?: string;
}

const { size = 'h-5 w-5' } = Astro.props;
---

<svg
	class={size}
	viewBox="0 0 16 16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<rect x="1.75" y="3.25" width="12.5" height="9.5" rx="1.5" />
	<path d="m2.5 4.5 5.5 4.25 5.5-4.25" />
</svg>
