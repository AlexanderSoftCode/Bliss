---
import { Code } from 'astro:components';
import type { ComponentProps} from 'astro/types';

interface Props {
  code: string;
  lang: ComponentProps<typeof Code>['lang'];
}

const { code, lang} = Astro.props;
---

<div class="overflow-hidden rounded-md [&_pre]:px-2 [&_pre]:py-1">
    <header class="grid grid-cols-[1fr_auto_1fr] items-center bg-[oklch(34%_0.025_298)] px-2">
        <div class="flex flex-row items-center gap-2">
            <div class="h-3 w-3 rounded-full bg-[#FF605C]"></div>
            <div class="h-3 w-3 rounded-full bg-[#FFBD44]"></div>
            <div class="h-3 w-3 rounded-full bg-[#00CA4E]"></div>
        </div>
        <div>~/projects/model.py</div>
        <div></div>
    </header>
    <Code code={code} lang={lang}></Code>
</div>
