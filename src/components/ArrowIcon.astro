---
interface Props {
	/** Tailwind sizing classes, so callers can match the arrow to their text size. */
	size?: string;
}

const { size = 'h-4 w-4' } = Astro.props;
---

<svg
	class:list={[
		size,
		'origin-left translate-y-0.5 transition-transform group-hover:translate-x-1 group-hover:scale-x-[1.125]',
	]}
	viewBox="0 0 16 16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<path d="M2 8h12M9.5 3.5 14 8l-4.5 4.5" />
</svg>
