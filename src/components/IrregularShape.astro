---
// Sized and positioned by the page through `class`; the fallback and canvas fill whatever box it gets.
const { class: className } = Astro.props;
---

<div class:list={['irregular-shape', className]}>

    <div class="shape-fallback h-full w-full rounded-full bg-surface"></div>
    <canvas class="shape-canvas absolute inset-0 h-full w-full cursor-grab touch-none active:cursor-grabbing" hidden></canvas>
</div>

<script>
  import { mountShape } from "../lib/shape/mount.ts";

  // mountShape checks for WebGPU itself and resolves null if it's missing.
  async function init() {
    const canvas = document.querySelector<HTMLCanvasElement>('.shape-canvas'); //. prefix means class
    const fallback = document.querySelector<HTMLElement>('.shape-fallback');
    if (!canvas || !fallback) return;
    const show = (mounted: boolean) => {
      canvas.hidden = !mounted;
      fallback.hidden = mounted;
    };
    const stop = await mountShape(canvas, () => show(false));
    if (!stop) return; // fallback stays
    show(true);
    addEventListener('pagehide', stop, { once: true }); // release the GPU before Firefox freezes or unloads the page
  }
  init();
  addEventListener('pageshow', (e) => { if (e.persisted) init(); }); // restored from the back/forward cache: the device is gone, remount
</script>
