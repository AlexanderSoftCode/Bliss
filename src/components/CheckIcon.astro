---
interface Props {
	/** Tailwind sizing classes, so callers can match the icon to their text size. */
	size?: string;
}

const { size = 'h-5 w-5' } = Astro.props;
---

<svg
	class={size}
	viewBox="0 0 16 16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<path d="m3 8.5 3.25 3.25L13 4.75" />
</svg>
