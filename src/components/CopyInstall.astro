---
import MailIcon from './MailIcon.astro';
import CheckIcon from './CheckIcon.astro';

interface Props {
	command: string;
	look?: 'boxed' | 'light' | 'text';
}

const { command, look = 'boxed' } = Astro.props;

// The light and text looks are the email buttons: the address never appears as plain text in the
// HTML, so scrapers searching the page for "@" find nothing. The script decodes it when clicked.
// The text look adds a generic "contact[at]domain" label beside the icon, so the real name part
// of the address stays hidden.
const isEmail = look !== 'boxed';
const isText = look === 'text';
const payload = isEmail ? btoa(command) : command;
const label = isEmail ? 'Copy email address' : `Copy ${command} to clipboard`;
---

{
  isEmail ? (
    <>
      <button
        type="button"
        class:list={[
          'copy-btn group text-text-muted transition-colors hover:text-accent-hover',
          isText && 'inline-flex items-center gap-2',
        ]}
        data-command={payload}
        data-encoded
        aria-label={label}
        title={label}
      >
        <span class="group-data-copied:hidden"><MailIcon /></span>
        <span class="hidden group-data-copied:inline"><CheckIcon /></span>
        {isText && (
          <>
            <span class="group-data-copied:hidden">contact[at]{command.split('@')[1]}</span>
            <span class="hidden group-data-copied:inline">Copied!</span>
          </>
        )}
      </button>
      <span class="copy-status sr-only" role="status"></span>
    </>
  ) : (
    <div class="copy-install flex items-center justify-between gap-4 rounded-lg border border-border bg-surface px-4 py-3 font-mono text-sm text-text">
      <code>{command}</code>
      <button
        type="button"
        class="copy-btn group shrink-0 rounded-md border border-border px-3 py-1 font-sans text-xs font-medium text-text-muted hover:border-accent hover:text-accent-hover"
        data-command={payload}
        aria-label={label}
      >
        <span class="group-data-copied:hidden">Copy</span>
        <span class="hidden group-data-copied:inline">Copied!</span>
      </button>
      <span class="copy-status sr-only" role="status"></span>
    </div>
  )
}

<script>
  // Feedback is a data attribute the markup reacts to, so the script never rewrites
  // the button's contents (which would delete an icon).
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((button) => {
    const status = button.nextElementSibling?.matches('.copy-status') ? button.nextElementSibling : null;

    let timeoutId: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener('click', async () => {
      clearTimeout(timeoutId);

      const payload = button.dataset.command ?? '';
      await navigator.clipboard.writeText(button.hasAttribute('data-encoded') ? atob(payload) : payload);

      button.toggleAttribute('data-copied', true);
      if (status) status.textContent = 'Copied to clipboard';

      timeoutId = setTimeout(() => {
        button.toggleAttribute('data-copied', false);
        if (status) status.textContent = '';
        timeoutId = undefined;
      }, 1500);
    });
  });
</script>
