---
import OrbLogo from "../components/OrbLogo.astro";
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="border-border">
    <nav aria-label="Main" class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
        <a href="/" class="group flex items-center gap-3">
            <div class="flex h-8 w-8 items-center justify-center overflow-visible" style="--sphere-size: 32px;">
                <OrbLogo />
            </div>

            <span class="font-mono text-sm font-semibold text-text transition-colors duration-150 group-hover:text-accent-hover">
                Alexander
            </span>
        </a>

        <ul class="flex gap-6 text-sm font-mono">
            {links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        aria-current={path === link.href ? 'page' : undefined}
                        class="text-text-muted hover:text-accent-hover aria-[current=page]:text-text transition-colors duration-150"
                    >
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</header>
