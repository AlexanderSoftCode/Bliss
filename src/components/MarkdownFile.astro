---
import { Code } from 'astro:components';
import type { MarkdownInstance } from 'astro';

interface Props {
	/** Path shown in the header, e.g. "/CLAUDE.md". */
	title: string;
	/** The imported module: `import * as file from './some.md'`. */
	file: MarkdownInstance<Record<string, any>>;
	/** Relative links in the rendered view resolve against this, e.g. a GitHub blob URL. */
	linkBase?: string;
	/** Short text after the line count, e.g. "snapshot · Nov 2026". */
	note?: string;
	open?: boolean;
}

const { title, file, linkBase, note, open = false } = Astro.props;

const raw = file.rawContent().trimEnd();
const lines = raw.split('\n').length;
const meta = [`${lines} lines`, note].filter(Boolean).join(' · ');

let html = await file.compiledContent();
if (linkBase) {
	html = html.replace(/href="(?!https?:|mailto:|#|\/)/g, `href="${linkBase}`);
}

// One radio group per viewer, so two on a page don't switch each other.
const group = `md-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${raw.length}`;
---

<!-- A file shown two ways. Collapsing is <details>; the view switch is two radios read by :has(). No script. -->
<figure class="my-8">
<div class="md-file relative overflow-hidden rounded-xl border border-border bg-surface">
	<fieldset class="toggle absolute right-3 top-2 flex gap-0.5 rounded-lg border border-border bg-bg p-0.5">
		<legend class="sr-only">View {title} as</legend>
		<label title="Rendered">
			<input type="radio" name={group} value="rendered" checked class="sr-only" />
			<span class="sr-only">Rendered</span>
			<svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8Z" />
				<circle cx="8" cy="8" r="2" />
			</svg>
		</label>
		<label title="Raw markdown">
			<input type="radio" name={group} value="raw" class="sr-only" />
			<span class="sr-only">Raw markdown</span>
			<svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M5 4.5 1.5 8 5 11.5M11 4.5 14.5 8 11 11.5M9.25 3 6.75 13" />
			</svg>
		</label>
	</fieldset>

	<details open={open}>
		<summary class="flex cursor-pointer items-center gap-3 py-3 pl-4 pr-4 text-sm text-text-muted hover:text-text">
			<svg class="chevron h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="m6 3.5 4.5 4.5L6 12.5" />
			</svg>
			<span class="mono shrink-0 text-text">{title}</span>
			<span class="mono min-w-0 truncate text-xs">{meta}</span>
			<span class="hint mono ml-auto shrink-0 text-xs text-accent">SHOW FILE</span>
		</summary>
		<div class="rendered border-t border-border px-6 py-6 sm:px-8" set:html={html} />
		<div class="raw border-t border-border px-4 py-4 text-sm leading-6">
			<Code code={raw} lang="md" wrap />
		</div>
	</details>
</div>
{Astro.slots.has('default') && (
	<figcaption class="mt-3 px-1 text-sm leading-6 text-text-muted"><slot /></figcaption>
)}
</figure>

<style>
	.mono {
		font-family: var(--font-heading);
		letter-spacing: 0.04em;
	}

	summary {
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: -2px;
		border-radius: 0.75rem;
	}
	/* Closed, the row says it opens; open, that corner belongs to the view switch. */
	.md-file {
		transition: border-color 150ms ease;
	}
	.md-file:not(:has(details[open])):has(summary:hover) {
		border-color: var(--color-accent);
	}
	summary:hover .hint {
		color: var(--color-accent-hover);
	}
	details[open] .hint {
		display: none;
	}
	details[open] > summary {
		padding-right: 6rem;
	}
	.chevron {
		transition: transform 200ms ease;
	}
	details[open] .chevron {
		transform: rotate(90deg);
	}
	@media (prefers-reduced-motion: reduce) {
		.chevron {
			transition: none;
		}
	}

	/* The switch only means something while the file is open. */
	.md-file:not(:has(details[open])) .toggle {
		display: none;
	}
	.toggle label {
		display: flex;
		height: 1.75rem;
		width: 1.75rem;
		cursor: pointer;
		align-items: center;
		justify-content: center;
		border-radius: 0.375rem;
		color: var(--color-text-muted);
	}
	.toggle label:hover {
		color: var(--color-text);
	}
	.toggle label:has(:checked) {
		background: var(--color-border);
		color: var(--color-text);
	}
	.toggle label:has(:focus-visible) {
		outline: 2px solid var(--color-accent);
		outline-offset: 1px;
	}

	.raw,
	.md-file:has(input[value='raw']:checked) .rendered {
		display: none;
	}
	.md-file:has(input[value='raw']:checked) .raw {
		display: block;
	}
	.raw :global(pre) {
		background: transparent !important;
	}

	/* The rendered file is someone else's markup, so it gets its own small type scale. */
	.rendered {
		font-size: 1rem;
		line-height: 1.75rem;
		color: var(--color-text-muted);
	}
	.rendered :global(h1),
	.rendered :global(h2),
	.rendered :global(h3) {
		color: var(--color-text);
		line-height: 1.3;
	}
	.rendered :global(h1) {
		font-size: 1.25rem;
	}
	.rendered :global(h2) {
		margin-top: 1.75rem;
		font-size: 1.125rem;
	}
	.rendered :global(h3) {
		margin-top: 1.25rem;
		font-size: 1rem;
	}
	.rendered :global(p),
	.rendered :global(ul),
	.rendered :global(ol),
	.rendered :global(pre) {
		margin-top: 0.75rem;
	}
	.rendered :global(ul),
	.rendered :global(ol) {
		padding-left: 1.25rem;
	}
	.rendered :global(ul) {
		list-style: disc;
	}
	.rendered :global(ol) {
		list-style: decimal;
	}
	.rendered :global(li + li) {
		margin-top: 0.375rem;
	}
	.rendered :global(li::marker) {
		color: color-mix(in oklab, var(--color-text-muted) 60%, transparent);
	}
	.rendered :global(strong) {
		color: var(--color-text);
	}
	.rendered :global(a) {
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: underline;
	}
	.rendered :global(a:hover) {
		color: var(--color-accent-hover);
	}
	.rendered :global(:not(pre) > code) {
		border: 1px solid var(--color-border);
		border-radius: 0.25rem;
		background: var(--color-bg);
		padding: 0.125rem 0.375rem;
		font-size: 0.875rem;
		color: var(--color-text);
		overflow-wrap: anywhere;
	}
	.rendered :global(pre) {
		overflow-x: auto;
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
		font-size: 0.875rem;
	}
	.rendered :global(> :first-child) {
		margin-top: 0;
	}
</style>
