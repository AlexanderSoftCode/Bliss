---
import { GITHUB_TOKEN, GITHUB_USERNAME } from 'astro:env/server';

interface Props {
	username?: string;
}

const { username = GITHUB_USERNAME } = Astro.props;

const LEVELS = {
	NONE: 0,
	FIRST_QUARTILE: 1,
	SECOND_QUARTILE: 2,
	THIRD_QUARTILE: 3,
	FOURTH_QUARTILE: 4,
} as const;

interface Day {
	date: string;
	contributionCount: number;
	contributionLevel: keyof typeof LEVELS;
}

const query = `query($login: String!, $from: DateTime!, $to: DateTime!) {
	user(login: $login) {
		contributionsCollection(from: $from, to: $to) {
			contributionCalendar {
				totalContributions
				weeks { contributionDays { date contributionCount contributionLevel } }
			}
		}
	}
}`;

const to = new Date();
const from = new Date(to);
from.setUTCDate(from.getUTCDate() - 7 * 52);

const response = await fetch('https://api.github.com/graphql', {
	method: 'POST',
	headers: {
		Authorization: `bearer ${GITHUB_TOKEN}`,
		'Content-Type': 'application/json',
	},
	body: JSON.stringify({
		query,
		variables: { login: username, from: from.toISOString(), to: to.toISOString() },
	}),
});

const payload = await response.json();
const calendar = payload?.data?.user?.contributionsCollection?.contributionCalendar;

// Fail the build rather than silently shipping an empty graph.
if (!calendar) {
	const reason = payload?.errors?.[0]?.message ?? payload?.message ?? 'no calendar returned';
	throw new Error(`ContributionGraph: GitHub request failed for "${username}" — ${reason}`);
}

const weeks: { contributionDays: Day[] }[] = calendar.weeks;
const days = weeks.flatMap((week) => week.contributionDays);

// One label per month, dropped when the next one is too close to render legibly.
const starts = weeks.flatMap((week, column) => {
	const date = new Date(`${week.contributionDays[0].date}T00:00:00Z`);
	const previous = weeks[column - 1]?.contributionDays[0].date;
	const isNewMonth = !previous || new Date(`${previous}T00:00:00Z`).getUTCMonth() !== date.getUTCMonth();
	return isNewMonth
		? [{ label: date.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' }), column: column + 1 }]
		: [];
});
const months = starts.filter((month, i) => {
	const next = starts[i + 1];
	return !next || next.column - month.column >= 3;
});

const formatDate = (date: string) => date.split('-').reverse().join('.');
const formatCount = (count: number) =>
	count === 0 ? 'No contributions' : `${count} contribution${count === 1 ? '' : 's'}`;
---

<section class="graph glass relative rounded-lg p-6">
	<p class="text-sm text-text-muted">Contributions</p>
	<h2 class="mt-1 text-2xl font-semibold text-text">Github</h2>

	<div class="mt-6 overflow-x-auto pb-1">
		<div class="months text-xs text-text-muted">
			{months.map((month) => (
				<span style={`grid-column-start: ${month.column}`}>{month.label}</span>
			))}
		</div>

		<div
			class="days mt-2"
			role="img"
			aria-label={`${calendar.totalContributions} GitHub contributions in the last year`}
		>
			{days.map((day) => (
				<div
					class="day"
					style={`--level: var(--graph-${LEVELS[day.contributionLevel]})`}
					data-date={formatDate(day.date)}
					data-count={formatCount(day.contributionCount)}
				/>
			))}
		</div>
	</div>

	<div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm text-text-muted">
		<p>
			{calendar.totalContributions} contributions in the last year on{' '}
			<a
				href={`https://github.com/${username}`}
				class="text-accent underline hover:text-accent-hover"
			>GitHub</a>.
		</p>
		<div class="flex items-center gap-1">
			<span>Less</span>
			{[0, 1, 2, 3, 4].map((level) => (
				<span class="swatch" style={`--level: var(--graph-${level})`} />
			))}
			<span>More</span>
		</div>
	</div>

	<div
		class="tip pointer-events-none absolute z-10 rounded-md bg-bg px-2 py-1 text-xs whitespace-nowrap text-text shadow-lg"
		aria-hidden="true"
	>
	</div>
</section>

<style>
	.graph {
		/* Columns stretch to fill the card, but never shrink past --cell-min;
		   below that the grid overflows and the wrapper scrolls. */
		--cell-min: 10px;
		--gap: 4px;
	}

	.months {
		display: grid;
		grid-template-columns: repeat(53, minmax(var(--cell-min), 1fr));
		gap: var(--gap);
	}

	.days {
		display: grid;
		grid-template-rows: repeat(7, auto);
		grid-auto-flow: column;
		grid-auto-columns: minmax(var(--cell-min), 1fr);
		gap: var(--gap);
	}

	.day {
		aspect-ratio: 1;
		border-radius: 2px;
		background: var(--level);
	}

	.swatch {
		width: 10px;
		height: 10px;
		border-radius: 2px;
		background: var(--level);
	}

	.tip {
		/* Anchored to the card's padding box so --x/--y line up with
		   offsetLeft/offsetTop, which are measured from the same origin. */
		top: 0;
		left: 0;
		opacity: 0;
		/* Individual transform properties, so position and scale animate on
		   separate curves. --x/--y are set by the script. */
		translate: calc(var(--x, 0px) - 50%) calc(var(--y, 0px) - 100% - 8px);
		scale: 0.9;
		transform-origin: 50% 100%;
		/* Exit: quicker, no overshoot. Position never animates while hidden. */
		transition:
			opacity 90ms ease-out,
			scale 90ms ease-out,
			translate 0s;
	}

	.tip[data-visible] {
		opacity: 1;
		scale: 1;
		/* Entrance: spring on scale. Position is deliberately instant — a glide
		   trails the cursor, and the tooltip's width changes with its text. */
		transition:
			opacity 130ms ease,
			scale 130ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		.tip,
		.tip[data-visible] {
			scale: 1;
			transition: opacity 130ms ease;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.graph').forEach((graph) => {
		const grid = graph.querySelector<HTMLElement>('.days');
		const tip = graph.querySelector<HTMLElement>('.tip');
		const scroller = grid?.parentElement;
		if (!grid || !tip || !scroller) return;

		grid.addEventListener('mouseover', (event) => {
			const cell = (event.target as HTMLElement).closest<HTMLElement>('.day');
			if (!cell) return;

			tip.textContent = `${cell.dataset.count} on ${cell.dataset.date}`;
			tip.style.setProperty('--x', `${cell.offsetLeft + cell.offsetWidth / 2 - scroller.scrollLeft}px`);
			tip.style.setProperty('--y', `${cell.offsetTop}px`);
			tip.toggleAttribute('data-visible', true);
		});

		const hide = () => tip.toggleAttribute('data-visible', false);
		grid.addEventListener('mouseleave', hide);
		scroller.addEventListener('scroll', hide);
	});
</script>
