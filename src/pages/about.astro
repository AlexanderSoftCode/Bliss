---
import Layout from '../layouts/Layout.astro';
import CopyInstall from '../components/CopyInstall.astro';
import GithubIcon from '../components/GithubIcon.astro';
import { CONTACT_EMAIL } from 'astro:env/server';
---

<Layout title="About — Alexander" description="About Alexander Tobias: An AI engineer building backend systems, and the creator of Aether-ML.">
	<section class="mx-auto max-w-3xl px-6 py-16">
		<h1 class="text-3xl font-bold">About Me</h1>
		<p class="mt-4 text-text-muted">
			I'm a Spring 2026 graduate of the <a
				href="https://www.uhd.edu"
				class="font-semibold text-accent underline hover:text-accent-hover"
				>University of Houston-Downtown</a> with a B.S. in Computer Science, taking a gap year to
			build backend systems. I'd rather spend that time getting properly technical with system
			architecture than divide my attention between job hunting and learning.
		</p>

		<p class="mt-4 text-text-muted">
		    My main project is <a
				href="/projects/aether-ml"
				class="font-semibold text-accent underline hover:text-accent-hover"
				>Aether-ML</a> — a deep learning framework
			I built from scratch, with JIT-compiled kernels for both CUDA and ROCm/HIP and branch
			conditionals resolved ahead of time rather than at runtime.
		</p>

		<p class="mt-4 text-text-muted">
			Want to get in touch? Find me here.
		</p>
		<div class="mt-4 flex items-center gap-3">
			<a
				href="https://github.com/AlexanderSoftCode"
				class="inline-flex items-center gap-2 text-text-muted transition-colors hover:text-accent-hover"
			>
				<GithubIcon />
				GitHub
			</a>
			<span class="text-accent" aria-hidden="true">/</span>
			<CopyInstall command={CONTACT_EMAIL} look="text" />
		</div>
		<h2 class="mt-8 text-2xl font-semibold">Hobbies</h2>

		<p class="mt-4 text-text-muted">
		    Outside of software I train (currently PPL UL) and build PCs. I've also spent far too many hours
			ricing my Linux desktop with Hyprland, where a working setup is always one animation curve
			away from a rewrite.
		</p>
	</section>
</Layout>
