---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CopyInstall from '../../components/CopyInstall.astro';
import convergence from '../../assets/benchmark_convergence-dark.png';
const features = [
	{
		name: 'Layers',
		detail: 'Conv2d, Dense, BatchNorm, MaxPool2d, AvgPool2d, GlobalAvgPool, Dropout, SpatialDropout, ReLU, LeakyReLU, Softmax, with He initialization and Philox counter-based PRNG for dropout masks.',
	},
	{
		name: 'Kernels',
		detail: 'Hand-written CUDA and HIP kernels for every layer and component except cheap elementwise ops like Dense and ReLU, with kernels JIT-compiled once per operation/shape and memoized after.'
	},
	{
		name: 'Training',
		detail: 'AdamW with decoupled weight decay, automated mixed precision, label smoothing, batch shuffling, and in-training validation.',
	},
	{
		name: 'Serialization',
		detail: '<code class="rounded border border-border bg-surface px-1.5 py-0.5 font-mono text-sm text-text">.aether</code> bundles a JSON architecture manifest with <em class="text-text">safetensors</em> weights, meaning no pickle anywhere in the load path.',
	},
	{
		name: 'Preprocessing',
		detail: 'Compose pipelines with Rescale, StandardScaler, and ToTensor.',
	},
];

const badges = [
	{ label: 'PyPI', value: 'aether-ml' },
	{ label: 'Tests', value: 'passing (CPU)' },
	{ label: 'Python', value: '3.12 · 3.13 · 3.14' },
	{ label: 'GPU', value: 'CUDA · ROCm' },
	{ label: 'License', value: 'MIT' },
];
---

<Layout
	title="Aether-ML — Alexander"
	description="A deep learning framework built from the ground up on NumPy and CuPy, with hand-written CUDA and ROCm kernels."
>
	<article class="mx-auto max-w-3xl px-6 py-16">
		<h1 class="text-3xl font-bold">Aether-ML</h1>
		<p class="mt-3 text-lg text-text-muted">
            A deep learning framework built from the ground up on <strong class="text-text">NumPy</strong> and <strong class="text-text">CuPy</strong>,
            with hand-written GPU kernels for both <strong class="text-text">CUDA</strong> and <strong class="text-text">ROCm</strong>.
		</p>
		<div class="mt-6 flex flex-wrap gap-2">
			{badges.map((badge) => (
				<span class="rounded-full border border-border bg-surface px-3 py-1 text-xs text-text-muted">
					<span class="font-medium text-text">{badge.label}</span> · {badge.value}
				</span>
			))}
		</div>

		<div class="mt-8">
			<CopyInstall command="pip install aether-ml" />
		</div>

		<img
			src="/cifar10_demo.webp"
			alt="Aether-ML training demo on CIFAR-10"
			width="1299"
			height="649"
			loading="lazy"
			decoding="async"
			class="mt-8 w-full rounded-lg border border-border"
		/>

		<h2 class="mt-12 text-xl font-semibold text-text">Why Aether-ML?</h2>
		<p class="mt-3 text-text-muted">
			Aether-ML implements forward/backward propagation, convolutional and fully connected networks,
			normalization, pooling, and losses without building on top of any existing deep learning
			library.
		</p>
		<p class="mt-3 text-text-muted">
		    With <strong class="text-text">CuPy</strong>, the GPU path leverages hand-written CUDA and
			HIP kernels resolved once at model construction. It's an intentionally ground-up project, as
			I started with no background in ML or GPU kernel programming, and in the process, it helped me
			understand how deep learning runtimes work under the hood.
		</p>

		<Image
			src={convergence}
			alt="Training convergence benchmark comparing NumPy CPU, legacy CuPy, vectorized CuPy, and fused-kernel CuPy backends, all converging to the same loss"
			class="mt-8 w-full rounded-lg border border-border"
		/>
		<p class="mt-3 text-sm text-text-muted">
			All four backends converge to the same loss; the fused-kernel CuPy path is the one built for
			speed.
		</p>

		<h2 class="mt-12 text-xl font-semibold text-text">Key Features</h2>
		<dl class="mt-4 space-y-6">
			{features.map((feature) => (
				<div>
					<dt class="font-medium text-text">{feature.name}</dt>
					<dd class="mt-1 text-text-muted" set:html={feature.detail} />
				</div>
			))}
		</dl>

		<div class="mt-12 flex gap-4 text-sm font-medium">
			<a
				href="https://github.com/AlexanderSoftCode/Aether-ML"
				class="glass rounded-md px-4 py-2 text-text hover:text-accent"
			>
				View on GitHub
			</a>
			<a
				href="https://pypi.org/project/aether-ml/"
				class="glass rounded-md px-4 py-2 text-text hover:text-accent"
			>
				View on PyPI
			</a>
		</div>
	</article>
</Layout>
