---
import Layout from '../../layouts/Layout.astro';
import CopyInstall from '../../components/CopyInstall.astro';

const features = [
	{
		name: 'Layers',
		detail: 'Conv2d, Dense, BatchNorm, MaxPool2d, AvgPool2d, GlobalAvgPool, Dropout, SpatialDropout, ReLU, LeakyReLU, Softmax, with He initialization and Philox counter-based PRNG for dropout masks.',
	},
	{
		name: 'Kernels',
		detail: 'Hand-written CUDA and HIP kernels for every compute layer, magic-number integer division for on-device index decomposition, and numerical stability guards throughout.',
	},
	{
		name: 'Training',
		detail: 'AdamW with decoupled weight decay, L1/L2 regularization inside the optimizer kernel, label smoothing, batch shuffling, in-training validation, and mixed precision via set_precision.',
	},
	{
		name: 'Serialization',
		detail: '.aether bundles pairing a JSON architecture manifest with safetensors weights — no pickle anywhere in the load path, so an untrusted checkpoint cannot execute code.',
	},
	{
		name: 'Preprocessing',
		detail: 'Compose pipelines with Rescale, StandardScaler, and ToTensor.',
	},
];

const badges = [
	{ label: 'PyPI', value: 'aether-ml' },
	{ label: 'Tests', value: 'passing (CPU)' },
	{ label: 'Python', value: '3.12 · 3.13 · 3.14' },
	{ label: 'GPU', value: 'CUDA · ROCm' },
	{ label: 'License', value: 'MIT' },
];
---

<Layout
	title="Aether-ML — Alexander"
	description="A deep learning framework built from the ground up on NumPy and CuPy, with hand-written CUDA and ROCm kernels."
>
	<article class="mx-auto max-w-2xl px-6 py-16">
		<h1 class="text-3xl font-bold">Aether-ML</h1>
		<p class="mt-3 text-lg text-text-muted">
			A deep learning framework built from the ground up on <strong class="text-text">NumPy</strong> and <strong class="text-text">CuPy</strong>,
			with hand-written GPU kernels for both CUDA and ROCm.
		</p>

		<div class="mt-6 flex flex-wrap gap-2">
			{badges.map((badge) => (
				<span class="rounded-full border border-border bg-surface px-3 py-1 text-xs text-text-muted">
					<span class="font-medium text-text">{badge.label}</span> · {badge.value}
				</span>
			))}
		</div>

		<div class="mt-8">
			<CopyInstall command="pip install aether-ml" />
		</div>

		<img
			src="https://raw.githubusercontent.com/AlexanderSoftCode/Aether-ML/main/notebooks/assets/cifar10_demo.webp"
			alt="Aether-ML training demo on CIFAR-10"
			class="mt-8 w-full rounded-lg border border-border"
		/>

		<h2 class="mt-12 text-xl font-semibold text-text">Why Aether-ML?</h2>
		<p class="mt-3 text-text-muted">
			Aether-ML implements forward and backward propagation, convolutional and fully connected
			networks, normalization, pooling, and losses without building directly off any existing deep
			learning libraries. The GPU path is not a thin wrapper over vectorized array operations — nearly
			all components run as hand-written kernels compiled from source templates targeting both NVIDIA
			and AMD hardware, with device backend, kernel-variant selection, and layer building resolved
			ahead of time at model construction rather than re-evaluated on every call.
		</p>
		<p class="mt-3 text-text-muted">
			It's an intentionally ground-up project, born knowing nothing about machine learning or GPU
			kernel programming, built instead to understand how deep learning runtimes actually work under
			the hood — system-level decisions, hardware dispatch, and memory footprints resolved by hand.
		</p>

		<h2 class="mt-12 text-xl font-semibold text-text">Key Features</h2>
		<dl class="mt-4 space-y-6">
			{features.map((feature) => (
				<div>
					<dt class="font-medium text-text">{feature.name}</dt>
					<dd class="mt-1 text-text-muted">{feature.detail}</dd>
				</div>
			))}
		</dl>

		<div class="mt-12 flex gap-4 text-sm font-medium">
			<a
				href="https://github.com/AlexanderSoftCode/Aether-ML"
				class="rounded-md border border-border px-4 py-2 text-text hover:border-accent hover:text-accent"
			>
				View on GitHub
			</a>
			<a
				href="https://pypi.org/project/aether-ml/"
				class="rounded-md border border-border px-4 py-2 text-text hover:border-accent hover:text-accent"
			>
				View on PyPI
			</a>
		</div>
	</article>
</Layout>
