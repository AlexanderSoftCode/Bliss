---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Alexander — Portfolio">
	<section class="mx-auto max-w-2xl px-6 py-16">
		<h1 class="text-4xl font-bold">Hi, I'm Alexander.</h1>
		<p class="mt-4 text-lg text-text-muted">Placeholder intro — replace with a real tagline.</p>
	</section>

	<section class="mx-auto max-w-2xl px-6 py-8">
		<h2 class="text-2xl font-semibold text-text">Featured: Aether-ML</h2>
		<p class="mt-2 text-text-muted">
			A deep learning framework built from the ground up on NumPy and CuPy, with hand-written CUDA
			and ROCm kernels.
		</p>
		<a href="/projects/aether-ml" class="mt-3 inline-block text-sm font-medium text-accent hover:text-accent-hover hover:underline">
			Read the case study &rarr;
		</a>
	</section>

	<section class="mx-auto max-w-2xl px-6 py-8">
		<h2 class="text-2xl font-semibold text-text">Other Projects</h2>
		<p class="mt-2 text-text-muted">Placeholder project grid.</p>
	</section>
</Layout>
