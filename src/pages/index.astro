---
import Layout from '../layouts/Layout.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import TechPill from '../components/TechPill.astro';
import IrregularShape from '../components/IrregularShape.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const aetherSnippet = `import aether as ae

model = ae.Model()
model.set_precision("float16")
model.to("cupy")
`
---

<Layout title="Alexander — Portfolio">
	<div class="mx-auto max-w-5xl px-6 py-16">
		<h1 class="mb-8 text-4xl font-bold">Alexander Tobias</h1>
		<div class="grid gap-8 md:grid-cols-5">
			<div class="md:col-span-3">
				<p class="text-lg text-text-muted">
					Ideas that I have about software are why I build. My work focuses on backend
					development across the AI stack, and most of it starts with wanting to understand
					<em class="text-text"> why</em> something works the way it does; hacking away
					at hard to grasp concepts until they click.
				</p>
				<p class="mt-4 text-lg text-text-muted">
					Outside of software, I enjoy working out, building PCs, and ricing my Linux desktop
					environment.
				</p>
				<div class="mt-6 flex items-center gap-3">
					<a
						href="https://github.com/AlexanderSoftCode"
						class="inline-flex items-center gap-2 text-text-muted transition-colors hover:text-accent"
					>
						<svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
						</svg>
						GitHub
					</a>
					<span class="text-accent" aria-hidden="true">/</span>
					<a
						href="/about"
						class="group inline-flex items-center gap-2 text-text-muted transition-colors hover:text-accent"
					>
						More about me
						<ArrowIcon />
					</a>
				</div>
			</div>
			<div class="relative md:col-span-2">
				<IrregularShape class="aspect-square md:absolute md:inset-x-0 md:top-1/2 md:-translate-y-1/2" />
			</div>
		</div>

		<h2 class="mt-12 text-2xl font-semibold text-text">Featured Projects</h2>
		<div class="mt-6 grid gap-6 sm:grid-cols-2">
			<a
				href="/projects/aether-ml"
				class="group rounded-xl border border-border bg-surface overflow-hidden transition-colors hover:border-accent"
			>
				<div class="p-6 motion-safe:transition-transform motion-safe:group-hover:scale-105 duration-300">
					<TerminalWindow title="~/projects/model.py" code={aetherSnippet} lang="python">
					</TerminalWindow>
				</div>
				<div class="px-6 pb-6">
					<h2 class="text-xl font-semibold text-text">Aether-ML</h2>
					<p class="mt-2 text-text-muted">
						A ground-up deep learning framework built on NumPy and CuPy, with JIT-compiled GPU kernels.
					</p>
					<div class="mt-2 flex flex-wrap gap-2">
						<TechPill name="python"></TechPill>
						<TechPill name="cpp"></TechPill>
						<TechPill name="cuda"></TechPill>
						<TechPill name="rocm"></TechPill>
					</div>
					<span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent group-hover:text-accent-hover">
						<span class="group-hover:underline">See how it works</span>
						<ArrowIcon size="h-3.5 w-3.5" />
					</span>
				</div>

			</a>
		</div>

		<div class="mt-12 max-w-3xl">
			<h2 class="text-2xl font-semibold text-text">What I work with</h2>
			<p class="mt-4 text-lg leading-8 text-text-muted">
				Most of what I write is <TechPill name="python" />. I've also worked in
				<TechPill name="java" />, <TechPill name="typescript" />, and
				<TechPill name="javascript" />, dropping into <TechPill name="cpp"/> for GPU kernel and
				compiler work.
			</p>
			<p class="mt-4 text-lg leading-8 text-text-muted">
				My machine learning work sits on <TechPill name="numpy" /> and
				<TechPill name="cupy" />, with <TechPill name="pytorch" />,
				<TechPill name="tensorflow" />, and <TechPill name="pandas" /> alongside them. This site
				is built with <TechPill name="astro" /> and <TechPill name="tailwind" />, and I reach for
				<TechPill name="docker" /> and <TechPill name="githubActions" /> to package and ship things.
			</p>
		</div>

		<div class="mt-12">
			<ContributionGraph />
		</div>
	</div>
</Layout>
