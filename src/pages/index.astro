---
import Layout from '../layouts/Layout.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
---

<Layout title="Alexander — Portfolio">
	<div class="mx-auto max-w-5xl px-6 py-16">
		<h1 class="mb-8 text-4xl font-bold">Alexander Tobias</h1>
		<div class="grid gap-8 md:grid-cols-3">
			<div class="md:col-span-2">
				<p class="text-lg text-text-muted">
					Ideas that I have about software are why I build. My work focuses on backend
					development across the AI stack, and most of it starts with wanting to understand
					<em class="text-text"> why</em> something works the
					way it does; hacking away at hard to grasp concepts until they click.
				</p>
				<p class="mt-4 text-lg text-text-muted">
					Outside of software, I enjoy working out, building PCs, and ricing my Linux desktop
					environment.
				</p>
				<div class="mt-6 flex items-center gap-3">
					<a
						href="https://github.com/AlexanderSoftCode"
						class="inline-flex items-center gap-2 text-text-muted transition-colors hover:text-accent"
					>
						<svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
						</svg>
						GitHub
					</a>
					<span class="text-accent" aria-hidden="true">/</span>
					<a
						href="/about"
						class="group inline-flex items-center gap-2 text-text-muted transition-colors hover:text-accent"
					>
						More about me
						<ArrowIcon />
					</a>
				</div>
			</div>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2">
			<a
				href="/projects/aether-ml"
				class="group rounded-lg border border-border bg-surface p-6 transition-colors hover:border-accent"
			>
				<h2 class="text-2xl font-semibold text-text">Featured: Aether-ML</h2>
				<p class="mt-2 text-text-muted">
					A deep learning framework built from the ground up on NumPy and CuPy, with hand-written
					CUDA and ROCm kernels.
				</p>
				<span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent group-hover:text-accent-hover">
					<span class="group-hover:underline">See how it works</span>
					<ArrowIcon size="h-3.5 w-3.5" />
				</span>
			</a>
		</div>

		<div class="mt-12">
			<ContributionGraph />
		</div>
	</div>
</Layout>
